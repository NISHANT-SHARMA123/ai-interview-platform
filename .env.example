# -----------------------------------------------------------------------------
# Core Django Settings
# -----------------------------------------------------------------------------
DEBUG=True
SECRET_KEY="generate-a-random-50+-character-secret-key-without-unescaped-hashes"
ALLOWED_HOSTS=127.0.0.1,localhost

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 Least-Privilege User)
# -----------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mock_interview_db
DB_USER=interview_app_user
DB_PASSWORD=SecureAppUserPassword123!
DB_HOST=localhost
DB_PORT=5432

# -----------------------------------------------------------------------------
# Security & CSRF
# -----------------------------------------------------------------------------
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# -----------------------------------------------------------------------------
# AI NLP Provider Configuration (Swappable: gemini, groq, mock)
# -----------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_REQUEST_TIMEOUT=15

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
